{
    "name": "3neti/election-ceremonies",
    "description": "Offline election ceremonies and signed election bundle verification",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-pdo_sqlite": "*",
        "ext-sodium": "*",
        "ext-zip": "*",
        "3neti/truth-qr": "^0.3",
        "illuminate/container": "^13.0",
        "illuminate/pipeline": "^13.0",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "LBHurtado\\ElectionCeremonies\\": "src/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
